#!/bin/bash
#SBATCH --job-name=test_strand
#SBATCH --partition=general-cpu
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --output=test_strand.%j.out
#SBATCH --error=test_strand.%j.err

set -euo pipefail

source ~/miniconda3/etc/profile.d/conda.sh
conda activate rseqc_env

SAMPLE=CFZ2110
R1=${SAMPLE}_1.fq.gz
R2=${SAMPLE}_2.fq.gz

INDEX=./GRCH38/humanht2
ANNOT=./GRCH38/gencode.v38.annotation.gff3

echo "Checking input files..."
ls -lh "$R1" "$R2" "$ANNOT"
ls ${INDEX}*.ht2

echo "Subsampling FASTQ..."
set +o pipefail
zcat "$R1" | head -n 400000 | gzip > ${SAMPLE}.sub_1.fq.gz
zcat "$R2" | head -n 400000 | gzip > ${SAMPLE}.sub_2.fq.gz
set -o pipefail
ls -lh ${SAMPLE}.sub_1.fq.gz ${SAMPLE}.sub_2.fq.gz

echo "Running HISAT2 without strandness..."
hisat2 -p 16 \
  --dta \
  -x "$INDEX" \
  -1 ${SAMPLE}.sub_1.fq.gz \
  -2 ${SAMPLE}.sub_2.fq.gz \
  2> ${SAMPLE}.sub.hisat2.log | \
samtools sort -@ 16 -o ${SAMPLE}.sub.sorted.bam -

samtools index -@ 16 ${SAMPLE}.sub.sorted.bam
ls -lh ${SAMPLE}.sub.sorted.bam ${SAMPLE}.sub.sorted.bam.bai

echo "Last lines of HISAT2 log:"
tail -n 20 ${SAMPLE}.sub.hisat2.log

echo "Converting annotation to BED..."
gffread "$ANNOT" -T -o ${SAMPLE}.tmp.gtf
gtfToGenePred ${SAMPLE}.tmp.gtf ${SAMPLE}.genePred
genePredToBed ${SAMPLE}.genePred ${SAMPLE}.bed
ls -lh ${SAMPLE}.bed
head ${SAMPLE}.bed

echo "Running infer_experiment.py..."
infer_experiment.py \
  -r ${SAMPLE}.bed \
  -i ${SAMPLE}.sub.sorted.bam \
  > ${SAMPLE}.infer_experiment.txt

echo "===== infer_experiment result ====="
cat ${SAMPLE}.infer_experiment.txt

#你的数据应按 unstranded 处理。

因为最关键的两项几乎一样：
	•	"1++,1--,2+-,2-+" = 0.4335
	•	"1+-,1-+,2++,2--" = 0.4424

这两组只差不到 1%，没有哪一边明显占优势。
如果是明确的 stranded 文库，通常会看到一边很高，比如 0.8 以上，另一边很低；你这个不是那种模式。

另外：
	•	failed to determine = 0.1242，12% 左右，算正常范围内，不影响这个总体判断
	•	真正有判别力的那两类 reads 几乎 50:50 分布，这就是 非链特异文库 的典型表现

所以你后面建议这样设：

HISAT2

不要加 --rna-strandness

也就是：hisat2 -p 16 --dta -x INDEX -1 sample_1.fq.gz -2 sample_2.fq.gz
featurecounts用 -s 0
